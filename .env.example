# =============================================================================
# Family Hub - Environment Variables
# =============================================================================
# Local development (pick one):
#   1. Doppler (recommended): doppler run -- turbo run dev
#   2. Manual .env: Copy this file to .env and fill in the values.
#
# CI: Uses hardcoded dummy values in .github/workflows/ci.yml
# Deployed environments: Managed by Doppler → synced to Railway/Vercel
#
# NEVER commit .env files with real values.
# =============================================================================

# ── Node ─────────────────────────────────────────────────────────────────────
# Use "production" for ALL deployed environments (dev, staging, prod)
# Use "development" only for local development
NODE_ENV=development

# ── Server ───────────────────────────────────────────────────────────────────
# Port for the API server (Railway injects this automatically)
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres:postgres@localhost:5432/family_hub?schema=public
# Supabase:   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# NOTE: If your Supabase password contains special characters (%, @, #, !),
#       URL-encode them (e.g., % → %25, @ → %40). Use: node -e "console.log(encodeURIComponent('password'))"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/family_hub?schema=public

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
# Railway: https://<service>.up.railway.app
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Redis ────────────────────────────────────────────────────────────────────
# Local:    redis://localhost:6379
# Upstash:  rediss://default:[password]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── GraphQL API (client apps) ───────────────────────────────────────────────
# Railway: https://<service>.up.railway.app/graphql
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
