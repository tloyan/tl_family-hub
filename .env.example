# =============================================================================
# Family Hub - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real values.
# =============================================================================

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server ───────────────────────────────────────────────────────────────────
# Port for the API server (Railway injects this automatically)
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres:postgres@localhost:5432/family_hub?schema=public
# Supabase:   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/family_hub?schema=public

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
# Dev:  https://dev-api-familyhub.tloyan.com
# Prod: https://api-familyhub.tloyan.com
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Redis ────────────────────────────────────────────────────────────────────
# Local:    redis://localhost:6379
# Upstash:  rediss://default:[password]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── GraphQL API (client apps) ───────────────────────────────────────────────
# Dev:  https://dev-api-familyhub.tloyan.com/graphql
# Prod: https://api-familyhub.tloyan.com/graphql
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
