{
  "extends": "@family-hub/config-ts/nextjs.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/.tsbuildinfo",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
