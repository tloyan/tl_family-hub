{
  "name": "family-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Family Hub - FamTech SaaS for family organization",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:doppler": "doppler run -- turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "turbo run db:generate --filter=@family-hub/db",
    "db:migrate:dev": "turbo run db:migrate:dev --filter=@family-hub/db",
    "db:push": "turbo run db:push --filter=@family-hub/db",
    "db:seed": "turbo run db:seed --filter=@family-hub/db",
    "db:studio": "turbo run db:studio --filter=@family-hub/db",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prettier": "^3.5.3",
    "turbo": "^2.8.12"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "apollo3-cache-persist>@apollo/client": "4"
      }
    },
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@nestjs/core",
      "@prisma/engines",
      "esbuild",
      "expo-modules-core",
      "prisma",
      "sharp"
    ]
  }
}
