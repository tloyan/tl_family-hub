{
  "name": "@family-hub/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens (colors, typography, spacing, radius, moments) for Family Hub",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": "./dist/css/variables.css",
    "./css/dark": "./dist/css/variables.dark.css",
    "./tailwind-preset": "./dist/tailwind/preset.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:tokens && pnpm run build:bundle",
    "build:tokens": "node sd.config.mjs",
    "build:bundle": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@family-hub/config-eslint": "workspace:*",
    "@family-hub/config-ts": "workspace:*",
    "eslint": "^9.0.0",
    "style-dictionary": "^5.3.3",
    "tsdown": "^0.20.0",
    "typescript": "^5.8.0"
  }
}
