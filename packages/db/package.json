{
  "name": "@family-hub/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma database layer for Family Hub",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsdown",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@family-hub/config-eslint": "workspace:*",
    "@family-hub/config-ts": "workspace:*",
    "@types/pg": "^8.15.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.0.0",
    "prisma": "^7.2.0",
    "tsdown": "^0.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
