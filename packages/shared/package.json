{
  "name": "@family-hub/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants, enums, and Zod schemas for Family Hub",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@family-hub/config-eslint": "workspace:*",
    "@family-hub/config-ts": "workspace:*",
    "eslint": "^9.0.0",
    "tsdown": "^0.21.1",
    "typescript": "^5.8.0"
  }
}
